+            final int budget = GameModePolicy.reclaimBudget();
+            synchronized (mService) {
+                final long now = SystemClock.uptimeMillis();
+                if (budget <= 0 || mGameModeTopApp != game || mService.getTopAppLocked() != game
+                        || mService.mWakefulness != PowerManagerInternal.WAKEFULNESS_AWAKE
+                        || (mLastGameModeReclaim != 0
+                            && now - mLastGameModeReclaim < GAME_MODE_RECLAIM_COOLDOWN_MS)) {
+                    return;
+                }
+                if (reclaimCachedAppsForGameLocked(game, budget) > 0) {
