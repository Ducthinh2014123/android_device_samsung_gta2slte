+    @GuardedBy("mService")
+    private void updateGameModeLocked(ProcessRecord topApp) {
+        final boolean isGame = topApp != null
+                && mService.mWakefulness == PowerManagerInternal.WAKEFULNESS_AWAKE
+                && topApp.getCurProcState() == PROCESS_STATE_TOP
+                && (topApp.info.category == ApplicationInfo.CATEGORY_GAME
+                        || (topApp.info.flags & ApplicationInfo.FLAG_IS_GAME) != 0
+                        // Some Minecraft builds do not declare a game category.
+                        || "com.mojang.minecraftpe".equals(topApp.info.packageName));
+        final ProcessRecord game = isGame ? topApp : null;
+        if (mGameModeTopApp == game) {
+            return;
+        }
+        mGameModeTopApp = game;
+        final Intent banner = new Intent(ACTION_GAME_MODE_CHANGED)
+                .setPackage("com.android.systemui")
+                .addFlags(Intent.FLAG_RECEIVER_REGISTERED_ONLY);
+        if (game != null) {
+            banner.putExtra(Intent.EXTRA_PACKAGE_NAME, game.info.packageName);
+            banner.putExtra(Intent.EXTRA_USER_HANDLE, UserHandle.getUserId(game.uid));
+        }
+        mService.mHandler.post(() -> mService.mContext.sendBroadcastAsUser(
+                banner, UserHandle.SYSTEM, android.Manifest.permission.STATUS_BAR_SERVICE));
+        if (mGameModeReclaim != null) {
+            mService.mHandler.removeCallbacks(mGameModeReclaim);
+            mGameModeReclaim = null;
+        }
+        if (game == null) {
+            Slog.i(TAG_OOM_ADJ, "Game mode ended");
+            return;
+        }
