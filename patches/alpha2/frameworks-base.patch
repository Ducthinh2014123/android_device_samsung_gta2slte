+            if (app.pid <= 0 || app.killedByAm || app.thread == null
+                    || app.uid == game.uid || !UserHandle.isApp(app.uid)
+                    || app.info.isSystemApp() || app.info.isUpdatedSystemApp()
+                    || app.shouldNotFreeze || app.setAdj < ProcessList.CACHED_APP_MIN_ADJ
+                    || app.setAdj > ProcessList.CACHED_APP_MAX_ADJ) {
+                continue;
+            }
+            mCachedAppOptimizer.compactAppSome(app);
+            queued++;
+        }
+        Slog.i(TAG_OOM_ADJ, "Game mode queued reclaim for " + queued + " cached processes");
+        return queued;
+    }
