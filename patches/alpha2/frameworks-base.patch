+
+package com.android.systemui;
+
+import android.Manifest;
+import android.animation.ValueAnimator;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageManager;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.text.TextPaint;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.animation.DecelerateInterpolator;
+
+final class GameModeBanner {
+    private static final String ACTION = "com.android.internal.intent.action.GAME_MODE_CHANGED";
+    private static final long HOLD_MS = 1550;
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final WindowManager mWindowManager;
+    private final Runnable mDismiss = this::dismiss;
+    private BannerView mView;
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (!ACTION.equals(intent.getAction())) {
+                return;
+            }
+            final String packageName = intent.getStringExtra(Intent.EXTRA_PACKAGE_NAME);
+            if (packageName == null) {
+                remove();
+                return;
+            }
+            final int user = intent.getIntExtra(Intent.EXTRA_USER_HANDLE, UserHandle.USER_SYSTEM);
+            show(getLabel(packageName, user));
+        }
+    };
+
+    GameModeBanner(Context context, Handler handler) {
+        mContext = context;
+        mHandler = handler;
+        mWindowManager = context.getSystemService(WindowManager.class);
+    }
+
+    void start() {
+        mContext.registerReceiver(mReceiver, new IntentFilter(ACTION),
+                Manifest.permission.STATUS_BAR_SERVICE, mHandler);
+    }
+
+    void stop() {
+        mContext.unregisterReceiver(mReceiver);
+        remove();
+    }
+
+    private CharSequence getLabel(String packageName, int user) {
+        try {
+            final PackageManager pm = mContext.createContextAsUser(UserHandle.of(user), 0)
+                    .getPackageManager();
+            return pm.getApplicationLabel(pm.getApplicationInfo(packageName, 0));
+        } catch (PackageManager.NameNotFoundException e) {
+            return "";
+        }
+    }
+
+    private void show(CharSequence label) {
+        remove();
+        final BannerView banner = new BannerView(mContext, label);
+        final int width = Math.min(banner.dp(392),
+                mContext.getResources().getDisplayMetrics().widthPixels - banner.dp(24));
+        final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                width, banner.dp(72), WindowManager.LayoutParams.TYPE_SYSTEM_OVERLAY,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE,
+                PixelFormat.TRANSLUCENT);
+        lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL;
+        lp.y = banner.dp(12);
+        lp.setTitle("SM-T385 Game Mode banner");
+
+        final boolean animate = ValueAnimator.areAnimatorsEnabled();
+        if (animate) {
+            banner.setAlpha(0f);
+            banner.setTranslationY(-banner.dp(14));
+            banner.setScaleX(.96f);
+            banner.setScaleY(.96f);
+        }
+        try {
+            mWindowManager.addView(banner, lp);
+        } catch (WindowManager.BadTokenException | WindowManager.InvalidDisplayException e) {
+            Log.w("GameModeBanner", "Unable to show game mode banner", e);
+            return;
+        }
+        mView = banner;
+        if (animate) {
+            banner.animate().alpha(1f).translationY(0f).scaleX(1f).scaleY(1f)
+                    .setDuration(260).setInterpolator(new DecelerateInterpolator()).start();
+        }
+        mHandler.postDelayed(mDismiss, HOLD_MS);
+    }
+
+    private void dismiss() {
+        final BannerView banner = mView;
+        if (banner == null || !ValueAnimator.areAnimatorsEnabled()) {
+            remove();
+            return;
+        }
+        banner.animate().alpha(0f).translationY(-banner.dp(10)).setDuration(180)
+                .withEndAction(() -> {
+                    if (mView == banner) {
+                        remove();
+                    }
+                }).start();
+    }
+
+    private void remove() {
+        mHandler.removeCallbacks(mDismiss);
+        final BannerView banner = mView;
+        mView = null;
+        if (banner != null) {
+            banner.animate().cancel();
+            mWindowManager.removeViewImmediate(banner);
+        }
+    }
+
+    private static final class BannerView extends View {
+        private static final int CYAN = 0xff58eeff;
+        private static final int VIOLET = 0xffa395ff;
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final TextPaint mTitlePaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        private final TextPaint mLabelPaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF mPanel = new RectF();
+        private final CharSequence mTitle;
+        private final CharSequence mLabel;
+        private final float mDensity;
+        private CharSequence mVisibleTitle;
+        private CharSequence mVisibleLabel;
+        private Shader mBorder;
+
+        BannerView(Context context, CharSequence label) {
+            super(context);
+            mDensity = getResources().getDisplayMetrics().density;
+            mTitle = context.getText(R.string.gta2slte_game_mode_on);
+            mLabel = label;
+            mTitlePaint.setTypeface(Typeface.create("sans-serif-medium", Typeface.BOLD));
+            mTitlePaint.setTextSize(dp(17));
+            mTitlePaint.setColor(Color.WHITE);
+            mLabelPaint.setTypeface(Typeface.create("sans-serif", Typeface.NORMAL));
+            mLabelPaint.setTextSize(dp(13));
+            mLabelPaint.setColor(0xffb5c9e6);
+            setContentDescription(TextUtils.isEmpty(label) ? mTitle : mTitle + ", " + label);
+        }
+
+        int dp(float value) {
+            return Math.round(mDensity * value);
+        }
+
+        @Override
+        protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+            mPanel.set(dp(2), dp(2), w - dp(2), h - dp(2));
+            mBorder = new LinearGradient(0, 0, w, h, CYAN, VIOLET, Shader.TileMode.CLAMP);
+            final int textWidth = Math.max(0, w - dp(94));
+            mVisibleTitle = TextUtils.ellipsize(mTitle, mTitlePaint, textWidth,
+                    TextUtils.TruncateAt.END);
+            mVisibleLabel = TextUtils.ellipsize(mLabel, mLabelPaint, textWidth,
+                    TextUtils.TruncateAt.END);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            mPaint.setStyle(Paint.Style.FILL);
+            mPaint.setColor(0xf5161e35);
+            canvas.drawRoundRect(mPanel, dp(16), dp(16), mPaint);
+
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setStrokeWidth(dp(1.5f));
+            mPaint.setShader(mBorder);
+            canvas.drawRoundRect(mPanel, dp(16), dp(16), mPaint);
+            mPaint.setShader(null);
+            mPaint.setStyle(Paint.Style.FILL);
+            mPaint.setColor(0xff253953);
+            canvas.drawCircle(dp(35), dp(36), dp(22), mPaint);
+
+            mPaint.setStyle(Paint.Style.STROKE);
+            mPaint.setColor(CYAN);
+            mPaint.setStrokeWidth(dp(2));
+            mPaint.setStrokeCap(Paint.Cap.ROUND);
+            canvas.drawRoundRect(dp(22), dp(28), dp(48), dp(44), dp(7), dp(7), mPaint);
+            canvas.drawLine(dp(28), dp(36), dp(34), dp(36), mPaint);
+            canvas.drawLine(dp(31), dp(33), dp(31), dp(39), mPaint);
+            canvas.drawPoint(dp(40), dp(35), mPaint);
+            canvas.drawPoint(dp(44), dp(38), mPaint);
+            mPaint.setStyle(Paint.Style.FILL);
+
+            canvas.drawText(mVisibleTitle, 0, mVisibleTitle.length(), dp(67),
+                    dp(TextUtils.isEmpty(mVisibleLabel) ? 42 : 32), mTitlePaint);
+            if (!TextUtils.isEmpty(mVisibleLabel)) {
+                canvas.drawText(mVisibleLabel, 0, mVisibleLabel.length(), dp(67), dp(51),
+                        mLabelPaint);
+            }
+        }
+    }
+}
