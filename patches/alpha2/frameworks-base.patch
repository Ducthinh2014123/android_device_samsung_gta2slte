+package com.android.server.am;
+
+import android.os.Process;
+import android.util.Slog;
+
+final class GameModePolicy {
+    private static final boolean NATIVE_AVAILABLE = loadNativePolicy();
+
+    private GameModePolicy() {}
+
+    private static boolean loadNativePolicy() {
+        try {
+            System.loadLibrary("gta2slte_game_mode");
+            return true;
+        } catch (LinkageError e) {
+            Slog.w("GameModePolicy", "Rust policy unavailable", e);
+            return false;
+        }
+    }
+
+    static int reclaimBudget() {
+        if (!NATIVE_AVAILABLE) {
+            return 0;
+        }
+        final long[] memory = {-1, -1};
+        Process.readProcLines("/proc/meminfo", new String[]{"MemAvailable:", "MemTotal:"},
+                memory);
+        try {
+            return nativeReclaimBudget(memory[0], memory[1],
+                    Runtime.getRuntime().availableProcessors());
+        } catch (LinkageError e) {
+            Slog.w("GameModePolicy", "Cannot invoke Rust policy", e);
+            return 0;
+        }
+    }
+
+    private static native int nativeReclaimBudget(long availableKib, long totalKib, int cpus);
+}
