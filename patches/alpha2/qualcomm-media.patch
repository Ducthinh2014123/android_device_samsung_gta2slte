 OMX_ERRORTYPE omx_vdec::decide_dpb_buffer_mode(bool split_opb_dpb_with_same_color_fmt)
 {
+    // The gta2slte Venus firmware uses combined linear buffers by default.
+    // It rejects the optional multi-stream controls used by newer firmware.
+    char device[PROPERTY_VALUE_MAX];
+    property_get("ro.product.device", device, "");
+    if (!strcmp(device, "gta2slte") && !secure_mode &&
+        eCompressionFormat == OMX_VIDEO_CodingAVC &&
+        dpb_bit_depth == MSM_VIDC_BIT_DEPTH_8 &&
+        capture_capability == V4L2_PIX_FMT_NV12 &&
+        !split_opb_dpb_with_same_color_fmt) {
+        return OMX_ErrorNone;
+    }
+
